# Recommended production source: fast nearby-place lookup with a free tier.
# Create a server-side key at https://myprojects.geoapify.com/ (do not expose it as NEXT_PUBLIC_*).
GEOAPIFY_API_KEY=
GEOAPIFY_PLACES_URL=https://api.geoapify.com/v2/places
# Per server process; keep provider-side quota alerts enabled as the authoritative cap.
GEOAPIFY_DAILY_REQUEST_LIMIT=1000

# Keyless fallbacks for development/light usage.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Photon is tried before Overpass so a slow Overpass instance cannot block the UI.
PHOTON_API_URL=https://photon.komoot.io/reverse

# Optional. Defaults to https://tile.openstreetmap.org/{z}/{x}/{y}.png
# If using another provider, follow that provider's tile and attribution terms.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_TILE_ATTRIBUTION=

# Reviews, photo uploads, and Google/Facebook login.
# Copy these from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only master key used by the review API. Never prefix with NEXT_PUBLIC,
# paste it into client code, logs, screenshots, chat, or commit it to Git.
SUPABASE_SECRET_KEY=

# Set to the canonical HTTPS origin in production, for example https://dateny.example.
DATENY_APP_ORIGIN=
# Optional comma-separated development tunnel origins. Leave empty normally.
DATENY_DEV_ORIGINS=

# Optional walking router; public FOSSGIS OSRM is for development/light usage.
OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
